rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // The app owner (Data center). Kept only here, not in the public site code.
    function isAdmin() { return signedIn() && request.auth.token.email == 'swaizyofficial@gmail.com' && request.auth.token.email_verified == true; }
    function small() { return request.resource.data.j is string && request.resource.data.j.size() < 900000; }

    // Your own profile and workouts: only you (the app owner can read them to moderate).
    match /users/{uid}/data/{docId} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isMe(uid);
      allow delete: if isAdmin();
    }
    // Moderation status (suspended / removed): everyone signed in can read it so the app hides those accounts; only the owner writes.
    match /moderation/{uid} { allow read: if signedIn(); allow write: if isAdmin(); }
    // Pop-up messages from BOATS to one person: only they read them; only the owner writes.
    match /notices/{uid} { allow read: if isMe(uid) || isAdmin(); allow write: if isAdmin(); }
    // Public cards, posts, likes/comments: signed-in users read, only the owner writes.
    match /people/{uid}    { allow read: if signedIn(); allow delete: if isMe(uid) || isAdmin(); allow create, update: if (isMe(uid) || isAdmin()) && small(); }
    match /posts/{uid}     { allow read: if signedIn(); allow delete: if isMe(uid) || isAdmin(); allow create, update: if (isMe(uid) || isAdmin()) && small(); }
    match /reactions/{uid} { allow read: if signedIn(); allow delete: if isMe(uid) || isAdmin(); allow create, update: if (isMe(uid) || isAdmin()) && small(); }
    // Feedback: only you (the app owner reads it in the Firebase console).
    match /feedback/{uid}  { allow read: if isMe(uid) || isAdmin(); allow delete: if isMe(uid) || isAdmin(); allow create: if isMe(uid) && small(); allow update: if (isMe(uid) || isAdmin()) && small(); }
    // Account list (email, name, join/last-seen dates): you write your own, only the owner reads all.
    match /accounts/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isMe(uid) && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email','name','createdAt','lastAt']);
    }
    // Full-quality photos for posts: photos/{uid}_{postId}. Signed-in users read, only the owner writes.
    match /photos/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.+') && small();
      allow delete: if signedIn() && (id.matches(request.auth.uid + '_.+') || isAdmin());
    }
    // Founding Crew numbers 1-100. Each member can take exactly one number, only the next free one, in the same write that advances the counter.
    match /meta/founders {
      allow read: if true;   // the splash shows how many people are on BOATS before sign-in
      allow update: if signedIn() && resource.data.next <= 100
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.keys().hasOnly(['next'])
        && getAfter(/databases/$(database)/documents/founders/$(request.auth.uid)).data.n == resource.data.next;
    }
    // The official BOATS account records its own id here so the app can show its badge.
    match /meta/official {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'boatsapplication@gmail.com' && request.auth.token.email_verified == true;
    }
    match /founders/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && request.resource.data.n is int
        && request.resource.data.n == get(/databases/$(database)/documents/meta/founders).data.next
        && getAfter(/databases/$(database)/documents/meta/founders).data.next == request.resource.data.n + 1;
    }
    // Photos sent in DMs: only the sender and the recipient can see them.
    match /dmphotos/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to + '_' + string(request.resource.data.at)
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
    // Usernames: first come, first served; only the holder can release one.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.size() <= 20 && name == name.lower()
        && (!name.matches('.*b+[o0]+[a4]+t.*') || request.auth.token.email == 'boatsapplication@gmail.com');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Exercise library: read-only for the app; edit in the console.
    match /library/{id}    { allow read: if signedIn(); }
    // Direct messages: one doc per sender→recipient, readable only by those two.
    match /threads/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && small()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
    }
  }
}
